# ===== nonebot-plugin-botui 配置示例（复制为 .env 后按需修改） =====

# --- 基础 ---
BOTUI_ENABLED=true
# WebUI 挂载路径（复用机器人自带的 FastAPI 应用，不额外占用端口）
BOTUI_ROUTE=/botui
# 提示链接里使用的主机名（只影响链接显示，不改变安全策略）
BOTUI_HOST=127.0.0.1
# 是否允许非本机来源访问；默认只允许本机。开启前请确认 BOTUI_AUTH=true
BOTUI_ALLOW_REMOTE=false
# 允许的 Host 头白名单（挡 DNS rebinding）：留空 = 不校验（默认）。
# 走域名/反向代理访问时填上域名即启用；本机主机名始终允许。BOTUI_ALLOW_REMOTE=true 时不限制。
# 例：BOTUI_ALLOWED_HOSTS=["bot.example.com"]
BOTUI_ALLOWED_HOSTS=[]
# 数据/缓存目录由 nonebot-plugin-localstore 管理，用它的配置项覆盖，例如：
# LOCALSTORE_DATA_DIR=/srv/nonebot/data
# LOCALSTORE_PLUGIN_DATA_DIR={"nonebot_plugin_botui": "/srv/botui/data"}

# --- 鉴权（强烈建议保持开启）---
BOTUI_AUTH=true
# 留空则自动生成并保存到数据目录的 token.txt
BOTUI_TOKEN=

# --- 记录 ---
BOTUI_CAPTURE_RECEIVED=true
BOTUI_CAPTURE_SENT=true
# 是否记录「自己发出的消息被适配器回传成事件」；关闭可避免同一条消息被记两次
BOTUI_CAPTURE_SELF=false
# 不记录这些适配器，例如 ('OneBot V12',)
BOTUI_EXCLUDE_ADAPTERS=[]
# 最多保留多少条消息，超出后自动删最旧的；0 表示不限制
BOTUI_MAX_RECORDS=200000
# 消息保留天数；0 表示不限制
BOTUI_RETENTION_DAYS=0
# 是否把 @某人 解析成群名片（会调用适配器接口并缓存）
BOTUI_RESOLVE_AT_NAME=true
# 调用适配器接口（取群成员信息等）的超时时间（秒）
BOTUI_API_TIMEOUT=10.0

# --- WebUI 行为 ---
# 聊天记录每页条数
BOTUI_PAGE_SIZE=50
# 是否允许在网页上代替机器人发消息
BOTUI_WRITE_ENABLED=true
# 是否允许在网页上撤回消息
BOTUI_ALLOW_RECALL=true
# 图片代理是否允许访问内网/环回地址。默认 false：只代理公网图片，避免被当成
# 跳板去读内网服务（含 169.254.169.254 这类云元数据地址）。图床确实在内网才改 true。
BOTUI_MEDIA_ALLOW_PRIVATE=false
# 是否允许在网页上在线预览收到的文件（文本 / 图片 / PDF / 音视频）
BOTUI_FILE_PREVIEW=true
# 文件下载代理允许的最大体积（字节）；0 表示不限制
BOTUI_FILE_MAX_BYTES=104857600

# --- 媒体库（收到的媒体与已发出的附件都存在这里，避免原链接失效）---
# 资源按内容 MD5 命名，落在 localstore 插件数据目录下的 blobs/；可用
# LOCALSTORE_PLUGIN_DATA_DIR={"nonebot_plugin_botui": "/srv/botui/data"} 覆盖。
# WebUI 选中的附件先暂存在系统临时目录（tempfile），发送那一刻才正式入库。
# 是否启用媒体库（下载收到的媒体、接收上传的附件）；关闭后链接只能实时代理
BOTUI_MEDIA_ENABLED=true
# 媒体库占用上限（字节，默认 512 MB），超出后淘汰最久未用的资源；0 表示不按体积限制
BOTUI_MEDIA_MAX_BYTES=536870912
# 媒体库文件数量上限；0 表示不按数量限制（内容相同的资源天然只有一份）
BOTUI_MEDIA_MAX_FILES=20000
# 单个资源进入媒体库的最大体积（字节，默认 20 MB）；0 表示不限制
BOTUI_MEDIA_FILE_MAX_BYTES=20971520
# 未被聊天记录引用的资源保留时长（秒，默认 3 天）；0 表示不按时间清理
BOTUI_MEDIA_TTL=259200.0
# 已被聊天记录引用的资源保留时长（秒，默认 7 天）；0 表示不限制
BOTUI_MEDIA_RETENTION=604800.0
# 下载单个媒体资源入库的超时时间（秒）
BOTUI_MEDIA_FETCH_TIMEOUT=20.0
# 单条消息最多下载多少字节入库（默认 20 MB）；0 表示不限制
BOTUI_MEDIA_MAX_BYTES_PER_MESSAGE=20971520
# 媒体库自动清理的间隔（分钟，默认 10）；0 表示只保留每 6 小时一次的消息记录清理
BOTUI_MEDIA_CLEANUP_INTERVAL=10
# 同一会话两次发送的最小间隔（秒）
BOTUI_SEND_INTERVAL=1.0

# --- 调试 ---
BOTUI_DEBUG=false
